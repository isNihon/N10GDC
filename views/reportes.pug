                                    //-----ID de REGISTRO
                                    input(type="number" name="idForm" id="idForm" hidden ).form-control
                                    //-----ID de detalle
                                    input(type="number" name="idd" id="idd" hidden ).form-control
                                    div.form-group.row(class="col-3 col-md-3" )
                                        //label(style="width:100%;") SDC:
                                        label(style="width:100%;") No.Orden Compra:
                                        input(type="text" name="SDS"  id="SDS"  ).form-control

                                    div.form-group.row(class="col-3 col-md-3" style="padding-left:15px")
                                        label(style="width:100%;") SDC:
                                        input(type="text" name="SDC"  id="SDC"  ).form-control

                                    div.form-group.row(class="col-3 col-md-3" style="padding-left:15px")
