                                            th(style="text-align:center") Nivel
                                            th(style="text-align:center") PRECIO
                                            th(style="text-align:center") PROVEEDOR
                                            th(style="text-align:center") COLOR


                            div(class="col-12 col-md-12" style="padding-top:50px" id="t-doc" hidden)
                                form(id="frmUploader" enctype="multipart/form-data" action="/pdf" method="post" style=";background-color:#E9F2F9;padding-top:10px;padding-bottom:15px")
                                    input(type="text" name="idPlanPro0" placeholder="" autocomplete="off" id="idPlanPro" hidden  ).form-control
                                    div.row.col-12.col-sm-12(style="justify-content:center;")
