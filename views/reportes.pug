                                        label(style="width:100%;") Nivel:
                                        select(class="form-control form-control-sm" name="Nivel" id="Nivel")
                                            option(value='') Seleccione Uno
                                            option(value='nv1') nv1
                                            option(value='nv2') nv2
                                            option(value='nv4') nv3


