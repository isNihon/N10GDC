                                        label(style="width:100%;") Ubicacion
                                        select(class="form-control form-control-sm" name="Ubicacion" id="Ubicacion")
                                            option(value='') Seleccione Uno
                                            option(value='U1') A.Recibo P1
                                            option(value='U2') A.Recibo P2
                                            option(value='U3') A.Recibo P3
                                            option(value='U7') C.Verde P1
                                            option(value='U8') C.Blanca P1
                                            option(value='U9') I.Recibo P1
                                            option(value='U10') I.Recibo P2
                                            option(value='U11') I.Recibo P3
                                            option(value='U4') Proceso P1
                                            option(value='U5') Proceso P2
                                            option(value='U6') Proceso P3


                                    div.form-group.row(class="col-3 col-md-3" style="padding-left:25px;padding-top:20px" )
                                        label(style="width:100%;") 
                                        button(type="button" class="btn btn-primary" onclick="saveFormDetalle()" ) 
                                            i(class="icon ion-ios-SAVE") 

