                                br              
                                div.row.col-12.col-sm-12(style=" background: white;padding-right:0px;padding-top:7px;padding-bottom:15px ; height: 100%")                                             
                                    div.col-12.col-sm-12(style="margin-bottom:20px;height: 100%")
