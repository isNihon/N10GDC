doctype html
html
  head
    title= title
    meta(name='viewport' content='initial-scale=1', width='device-width')
    link(rel='stylesheet', href='/css/bootstrap/bootstrap.min.css')
    link(rel='stylesheet', href='/css/login/font-awesome.min.css')
    link(href="https://unpkg.com/ionicons@4.5.0/dist/css/ionicons.min.css" rel="stylesheet")
    link(rel='stylesheet', href='/css/login/styleLogin.css')
    link(rel='stylesheet', href='/css/login/style.css')
    script(type="text/javascript" src="http://ajax.googleapis.com/ajax/libs/jquery/3.0.0/jquery.min.js")
    <script src="https://cdnjs.cloudflare.com/ajax/libs/notify/0.4.2/notify.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=UnifrakturCook:wght@700&display=swap" rel="stylesheet">


    

    body
        block content
            div.row

                div.col-md-8.col-8.row
                    img(src="../images/deka-1.png" style="width:100%").logo

                div.col-8
                    <p style="text-align:center;color:#000000!important;font-size: 3em;font-weight:900;font-family:'Verdana', sans-serif;text-shadow: -2px -2px 0 #ffffff, 2px -2px 0 #ffffff, -2px 2px 0 #ffffff, 2px 2px 0 #ffffff;">N10 SGCM</p>

            div(class="main")  	
                
                div(style="padding-left:15px;padding-top:5px" )

                    i(type="button"  class="icon ion-md-help-circle"
                    style="color:green"
                    onmouseover="this.style.transform='scale(2)'" 
                    onmouseout="this.style.transform='scale(1)'"
                    onclick="window.open('http://npms16.nipsa.com.mx:90/files/manuales/loggin.pdf',' ', 'width=1100,height=700')"
                    )

                <input type="checkbox" id="chk" aria-hidden="true">

                    div(class="signup")
                        label(for="chk" aria-hidden="true" style="color:black") LOGIN
                            i(class="icon ion-ios-lock")
                        form(action='/login' method='post')
                            div.form-group
                                input(type="password" name="password"  id="subdomain" autocomplete="off" style="border-radius:4654px;text-align: center;" placeholder="Password").form-control
                            div.form-group(style="display:none")
                                label Contraseña
                                input(type='text' name='username' placeholder='' value="User").form-control
                            
                            div.form-group
                                button(type='submit' style="border-radius:4654px;") Entrar
                                    i(class="icon ion-md-log-in") 


                    div(class="login")
                        label(for="chk" aria-hidden="true") PASSWORD
                            i(class="icon ion-ios-eye")
                        input(type='NUMBER' name="password"  id='REGISTRYNUMBER' placeholder="Employee number" autocomplete="off" style="border-radius:4654px;text-align: center;").form-control
                        button(type='bottom' style="border-radius:4654px;" onclick='sendDtata()' )
                            i(class="icon ion-md-mail") 

script(src='/js/loginn/login.js' type="text/javascript")
script(src='/js/loginn/reenviarAacceso.js' type="text/javascript")
script(src='/js/notify.min.js' type="text/javascript")