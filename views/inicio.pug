                    div.col-12.col-sm-12.row(style="padding-bottom:30px;padding-left:5px;background-color:#EBEDEF;margin-top:20px;padding-top:15px")
                        div.col-12.col-sm-12(style="padding-left:30px;padding-bottom:10px")
                          h6(style="color:#0A7B89;font-weight:bold") Mover Material
                        
                        div.col-5.col-sm-5.row(style="padding-left:30px")
                          div.col-10.col-sm-10.row
